# ============================================
# Required Environment Variables
# ============================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=pdf_extractor

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=change-this-password

# JWT Secret (REQUIRED - generate a random string)
JWT_SECRET=generate-a-random-64-char-string-here-minimum

# Gemini API Key (optional — markdown formatting & QA work without it)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# DeepSeek OCR2 — Local OCR Configuration
# ============================================

# OCR Provider: only "deepseek_ocr2" is supported (local, no cloud API)
OCR_PROVIDER=deepseek_ocr2

# Device: "cuda" for GPU, "cpu" for CPU-only
OCR_DEVICE=cuda

# Batch size for OCR processing
OCR_BATCH_SIZE=4

# Enable GPU acceleration (true/false)
OCR_USE_GPU=true

# OCR languages (comma-separated, e.g. "en,fr,de")
OCR_LANGUAGES=en

# DPI for page rendering (higher = better OCR, slower)
OCR_PAGE_DPI=200

# ============================================
# Optional Environment Variables
# ============================================

# Backend
PORT=8080
GIN_MODE=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://admin:admin123@localhost:5432/pdf_extractor?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AI_SERVICE_URL=http://localhost:8000
UPLOADS_DIR=./uploads
OUTPUTS_DIR=./outputs

# Frontend
FRONTEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# Embedding & Retrieval Settings
# ============================================

# Embedding provider: "sentence-transformers" (local, recommended) or "gemini"
EMBEDDING_PROVIDER=sentence-transformers

# Sentence-transformers model (default: all-mpnet-base-v2, 768d)
EMBEDDING_MODEL=all-mpnet-base-v2

# Embedding dimension (768 for all-mpnet-base-v2)
EMBEDDING_DIMENSION=768

# Retrieval settings
TOP_K_RESULTS=5
MIN_SIMILARITY=0.5
MAX_CONTEXT_CHARS=10000

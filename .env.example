# ============================================
# Required Environment Variables
# ============================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=pdf_extractor

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=change-this-password

# JWT Secret (REQUIRED - generate a random string)
JWT_SECRET=generate-a-random-64-char-string-here-minimum

# Gemini API Key (REQUIRED for AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Optional Environment Variables
# ============================================

# Backend
PORT=8080
GIN_MODE=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://admin:admin123@localhost:5432/pdf_extractor?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AI_SERVICE_URL=http://localhost:8000
UPLOADS_DIR=./uploads
OUTPUTS_DIR=./outputs

# Frontend
FRONTEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# Embedding & Retrieval Settings
# ============================================

# Embedding provider: "gemini", "sentence-transformers", or "auto" (try gemini first)
EMBEDDING_PROVIDER=auto

# Gemini embedding model (default: models/text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004

# Embedding dimension (768 for text-embedding-004 and all-mpnet-base-v2)
EMBEDDING_DIMENSION=768

# Retrieval settings
TOP_K_RESULTS=5
MIN_SIMILARITY=0.5
MAX_CONTEXT_CHARS=10000
